<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvClientName"
            android:layout_width="136dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:text="Client Name"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvInvoiceNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvClientName"
            android:text="#INV0000"

            />

        <TextView
            android:id="@+id/tvInvoiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvInvoiceNumber"
            android:text="Date" />

        <TextView
            android:id="@+id/tvInvoiceAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:text="$0.00"
            android:textAppearance="?attr/textAppearanceListItem"
            android:textColor="@color/tab_text_selected"
            android:textSize="14sp" />



        <TextView
            android:id="@+id/tvInvoiceStatus"
            android:layout_width="79dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvInvoiceAmount"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/status_background"
            android:gravity="center"
            android:padding="4dp"
            android:text="non validé"
            android:textAppearance="?attr/textAppearanceListItemSmall"
            android:textColor="@color/status_color1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvInvoiceStatus2"
            android:layout_width="71dp"

            android:layout_height="wrap_content"
            android:layout_below="@id/tvInvoiceAmount"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/status_background2"
            android:gravity="center"
            android:padding="4dp"
            android:text="validé"
            android:textAppearance="?attr/textAppearanceListItemSmall"
            android:textColor="@color/teal_700"
            android:textSize="15sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
