<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_add"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/background"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="gérer les utilisateurs"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:id="@+id/users_searchcontainer"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_below="@id/toolbar_add"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="visible">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/users_searchView"
                style="@style/AppSearchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_viewbg"
                android:visibility="visible"
                app:closeIcon="@drawable/custom_close_icon"
                app:iconifiedByDefault="false"
                app:queryHint="recherche"
                app:searchIcon="@drawable/custom_search_icon" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/users_searchcontainer">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:backgroundTint="@color/white">

                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                    <include layout="@layout/shimmereffectitem" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

        <!-- FloatingActionButton in the bottom-right corner -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="50dp"
            app:backgroundTint="@color/background"
            android:elevation="6dp"
            app:fabCustomSize="54dp"
            app:srcCompat="@android:drawable/ic_input_add"
            app:tint="@android:color/white" />

        <!-- RecyclerView Container -->
        <RelativeLayout
            android:id="@+id/recycler_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/users_searchcontainer">

            <LinearLayout
                android:id="@+id/error_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- TextView to display connection error message -->
                <TextView
                    android:id="@+id/tv_connection_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Veuillez vérifier votre connexion"
                    android:textSize="18sp" />

                <!-- Button to refresh -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="185dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/counter_text_color"
                    android:text="Rafraîchir"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    app:cornerRadius="26dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/image_no_items"
                android:layout_width="322dp"
                android:layout_height="206dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/emptyitem"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_no_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/image_no_items"
                android:layout_centerHorizontal="true"
                android:text="Aucun utilisateur !"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/users_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </RelativeLayout>

    </RelativeLayout>
</ScrollView>