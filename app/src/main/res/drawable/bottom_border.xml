<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background of the LinearLayout -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/> <!-- Change this to your desired background color -->
        </shape>
    </item>

    <!-- Bottom Border -->
    <item android:top="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" /> <!-- Transparent color for other sides -->
            <stroke android:width="1dp" android:color="#5B000000" /> <!-- Define border color and width here -->
        </shape>
    </item>
</layer-list>
